{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "server/**/*.ts",
    "agent/**/*.ts",
    "web/**/*.ts",
    "extension/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
